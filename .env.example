FLASK_DEBUG=0

# Set to false only when running without HTTPS (e.g. local HTTP deployment).
# When behind a reverse proxy, ensure X-Forwarded-Proto is forwarded correctly.
# Default: true
SESSION_COOKIE_SECURE=true

# Publieke basis-URL voor links in emails
APP_BASE_URL=https://tricount.yoursite.com

# SMTP (wekelijkse email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your@email.com
